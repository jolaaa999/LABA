# App
APP_ENV=development

# Backend server
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT_SEC=15
SERVER_WRITE_TIMEOUT_SEC=15
SERVER_IDLE_TIMEOUT_SEC=60

# MySQL (matches docker-compose.dev.yml defaults)
DB_HOST=127.0.0.1
# MariaDB dev compose → 3307; MySQL 8 compose → 3308
DB_PORT=3307
DB_USER=ai
DB_PASSWORD=ai
DB_NAME=ai_community
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=1800

# Vue Vite dev server origins (comma-separated). Never use * in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Relative to process working directory (usually backend/)
MIGRATIONS_DIR=migrations
